#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
mkdir -p outputs/grasp assets/models/engines .runtime/grasp .cache/grasp-wheels
compose=(docker compose -p wheel-robot-grasp -f compose.grasp.yaml)
case "${1:-help}" in
  relay|run) echo 'Simulation entry points have been removed; see Git commit 6726ba1 for the former implementation. Use tools/robot status for hardware development.' >&2; exit 2 ;;
  sources) exec python3 tools/grasp/bootstrap_sources.py ;;
  build-ros) exec "${compose[@]}" build ros_tools ;;
  download) exec "${compose[@]}" --profile tools run --rm download ;;
  verify-models) exec "${compose[@]}" --profile tools run --rm download tools/grasp/download_models.py --verify-only ;;
  build-perception) exec "${compose[@]}" build perception ;;
  check) exec "${compose[@]}" run --rm perception ;;
  engines) shift; exec "${compose[@]}" run --rm perception tools/grasp/build_engines.py "$@" ;;
  smoke) exec "${compose[@]}" run --rm perception tools/grasp/smoke_models.py ;;
  capture) shift; exec "${compose[@]}" run --rm ros_tools wheel-grasp capture "$@" ;;
  *) echo 'Usage: tools/grasp/environment {sources|build-ros|download|verify-models|build-perception|check|engines [--model sam|owl|all]|smoke|capture ...}' ;;
esac
